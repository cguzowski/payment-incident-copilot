{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://payment-incident-copilot.local/schemas/report-v1",
  "title": "Evidence-linked incident report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disposition", "summary", "observations", "inferences", "probableCause",
    "confidence", "recommendation", "contradictions", "evidenceGaps"
  ],
  "properties": {
    "disposition": { "enum": ["PROPOSED", "INSUFFICIENT_EVIDENCE"] },
    "summary": { "$ref": "#/$defs/evidenceOnlyClaim" },
    "observations": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/evidenceOnlyClaim" } },
    "inferences": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "probableCause": { "oneOf": [{ "$ref": "#/$defs/claim" }, { "type": "null" }] },
    "confidence": { "$ref": "#/$defs/confidence" },
    "recommendation": { "oneOf": [{ "$ref": "#/$defs/claim" }, { "type": "null" }] },
    "contradictions": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "evidenceGaps": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/gap" } }
  },
  "allOf": [
    {
      "if": { "properties": { "disposition": { "const": "PROPOSED" } } },
      "then": {
        "properties": {
          "probableCause": { "$ref": "#/$defs/claim" },
          "recommendation": { "$ref": "#/$defs/knowledgeClaim" }
        }
      }
    },
    {
      "if": { "properties": { "disposition": { "const": "INSUFFICIENT_EVIDENCE" } } },
      "then": {
        "properties": {
          "probableCause": { "type": "null" },
          "recommendation": { "type": "null" },
          "confidence": {
            "allOf": [
              { "$ref": "#/$defs/confidence" },
              { "properties": { "level": { "const": "LOW" } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "evidenceId": {
      "$ref": "#/$defs/uuid"
    },
    "knowledgeChunkId": {
      "$ref": "#/$defs/uuid"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidenceIds", "knowledgeChunkIds"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 300 },
        "evidenceIds": {
          "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceId" }
        },
        "knowledgeChunkIds": {
          "type": "array", "maxItems": 10, "uniqueItems": true,
          "items": { "$ref": "#/$defs/knowledgeChunkId" }
        }
      }
    },
    "evidenceOnlyClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidenceIds", "knowledgeChunkIds"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 300 },
        "evidenceIds": {
          "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceId" }
        },
        "knowledgeChunkIds": { "type": "array", "maxItems": 0 }
      }
    },
    "knowledgeClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidenceIds", "knowledgeChunkIds"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 300 },
        "evidenceIds": {
          "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceId" }
        },
        "knowledgeChunkIds": {
          "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
          "items": { "$ref": "#/$defs/knowledgeChunkId" }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale", "evidenceIds"],
      "properties": {
        "level": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 300 },
        "evidenceIds": {
          "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceId" }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    }
  }
}
