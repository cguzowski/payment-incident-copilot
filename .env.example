# Local development only. Do not use these values in a deployed environment.
POSTGRES_DB=payment_copilot
POSTGRES_USER=payment_copilot
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/payment_copilot
SPRING_DATASOURCE_USERNAME=payment_copilot
SPRING_DATASOURCE_PASSWORD=local_only_change_me

OPERATIONS_MCP_BASE_URL=http://localhost:8082
OPERATIONS_MCP_REQUEST_TIMEOUT=5s
REPORT_GENERATION_TIMEOUT=150s
# -1 lets Ollama choose GPU placement. Tune only after measuring available VRAM.
REPORT_GPU_LAYERS=-1
REPORT_BATCH_TOKENS=128
OLLAMA_BASE_URL=http://localhost:11434
REPORT_CHAT_MODEL=qwen3:8b-q4_K_M
COMPARISON_CHAT_MODEL=qwen3:8b-q4_K_M
COMPARISON_TIMEOUT=2m
COMPARISON_ARTIFACT_DIRECTORY=./tmp/comparisons
KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text
# Use 0s on memory-constrained GPUs to release embeddings before report generation.
KNOWLEDGE_EMBEDDING_KEEP_ALIVE=5m

# Ollama remains local and models are never pulled automatically. Never add AWS
# keys or bearer tokens here; hosted model providers are not part of the active
# local profile.
APP_KNOWLEDGE_INGESTION_ENABLED=false
APP_KNOWLEDGE_EMBEDDING_SMOKE_TEST_ENABLED=false
APP_REPORT_SMOKE_TEST_ENABLED=false
